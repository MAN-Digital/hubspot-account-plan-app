# ===========================================
# HubSpot Signal-First Account Workspace
# Copy to .env and fill in values.
# ===========================================

# --- Database ---
# Local dev: Docker Postgres on :5433 (see docker-compose.yml).
# Production tenants set DATABASE_URL to their own managed Postgres
# (Supabase / Neon / RDS / etc.) — the product is config-driven.
DATABASE_URL=postgresql://hap:hap_local_dev@localhost:5433/hap_dev
POSTGRES_USER=hap
POSTGRES_PASSWORD=hap_local_dev
POSTGRES_DB=hap_dev

# --- HubSpot signed-request auth (Slice 2 Step 4) ---
# Provided by `hs project upload` after the developer app is provisioned.
# Visible in HubSpot UI: Developer → Projects → hap-signal-workspace → Auth.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_APP_ID=
# Legacy — Slice 2 does NOT use this. Leave blank.
HUBSPOT_DEVELOPER_API_KEY=

# --- OAuth redirect (Slice 5) ---
# In local development the API may fall back to:
#   http://localhost:3000/oauth/callback
# In production/staging this MUST be set explicitly to an HTTPS callback URL.
# Example staging value:
# HUBSPOT_OAUTH_REDIRECT_URI=https://hap-signal-workspace-staging.vercel.app/oauth/callback
# Example production value:
# HUBSPOT_OAUTH_REDIRECT_URI=https://hap.mandigital.dev/oauth/callback
# HUBSPOT_OAUTH_REDIRECT_URI=

# --- Lifecycle subscription bootstrap (Slice 11) ---
# See docs/runbooks/slice-11-dev-quickstart.md §1 for the full contract.
# Developer-account app credentials (HubSpot developer UI → your app → Auth).
# Distinct from HUBSPOT_CLIENT_ID/SECRET above: these authenticate the
# client-credentials flow against the webhooks-journal subscriptions API.
HUBSPOT_APP_CLIENT_ID=
# Never log. Never echo. Rotate per env.
HUBSPOT_APP_CLIENT_SECRET=
# Public HTTPS URL of the lifecycle receiver. MUST byte-for-byte match
# <API_ORIGIN>/webhooks/hubspot/lifecycle for the active HubSpot profile.
LIFECYCLE_TARGET_URL=
# 32+ bytes from a CSPRNG; guards POST /admin/lifecycle/bootstrap.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_BOOTSTRAP_TOKEN=

# --- Vercel cron auth ---
# Bearer token Vercel sends to /admin/keep-alive (vercel.json cron).
# Set the same value in the Vercel project env. Generate like
# INTERNAL_BOOTSTRAP_TOKEN above.
CRON_SECRET=

# --- API Server ---
PORT=3001
NODE_ENV=development

# --- Encryption (Slice 2 Step 3) ---
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# This is the master KEK. Tenant KEKs are HKDF-derived per request and never
# leave the api process. Rotate per docs/security/SECURITY.md §Key Management.
ROOT_KEK=

# --- Provider API keys (cassette recording + dev fallback) ---
# At runtime, per-tenant keys live encrypted in llm_config / provider_config.
# These env vars exist for cassette recording during adapter development and
# as optional fallbacks. All optional — leave blank if you don't have the key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EXA_API_KEY=

# --- Supabase (optional managed Postgres alternative) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NOTE: The service_role key bypasses RLS and is intentionally NOT part of the
# application env. Application DB access must use the least-privilege `hap_app`
# role (see migration 0010 + docs/runbooks/least-privilege-db-role.md), never
# service_role. Only add service_role to a separate, tightly-scoped admin tool
# if a specific server-side operation genuinely requires bypassing RLS.
