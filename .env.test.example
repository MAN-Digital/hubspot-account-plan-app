# ===========================================
# Test-only env overrides (committed scaffold)
# ===========================================
#
# Easiest path: run `pnpm test:db:up` — it starts the local Postgres and
# copies this file to `.env.test.local` for you. Only copy manually if you
# want to customize values:  cp .env.test.example .env.test.local
#
# Real secrets (HUBSPOT_CLIENT_SECRET, ROOT_KEK, provider API keys) live
# in repo-root .env — see .env.example.
#
# vitest.setup.ts loads .env first, then .env.test.local with
# `override: true`. The values below are intentionally test-only and
# MUST NOT appear in any production environment.

NODE_ENV=test

# Local docker-compose Postgres (see docker-compose.yml: service `postgres`,
# host port 5433). Overrides the repo-root .env's managed/pooler DATABASE_URL.
# This is REQUIRED: loadEnv() in packages/config/src/env.ts refuses to start
# when ALLOW_TEST_AUTH=true is combined with a *.pooler.supabase.com host, so
# the test suite must point at a local database. Bring the container up and
# apply migrations before running tests — see
# docs/runbooks/local-test-database.md.
DATABASE_URL=postgresql://hap:hap_local_dev@localhost:5433/hap_dev

# Enables the x-test-portal-id auth bypass for tests.
# apps/api/src/middleware/auth.ts gates the bypass on this AND
# NODE_ENV === "test" — defense in depth.
ALLOW_TEST_AUTH=true

# Test portal pinned (HubSpot CLI default account).
HUBSPOT_TEST_PORTAL_ID=147062576
